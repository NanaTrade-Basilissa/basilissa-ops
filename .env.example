# Template. Copy to .env.local for local development:
#
#     cp .env.example .env.local
#
# WHICH FILE WINS
# ---------------
#   .env.local   local development. Gitignored. THIS is the one to edit for
#                `pnpm dev`, `pnpm db:migrate`, `pnpm db:seed`, `pnpm db:studio`.
#   .env         committed-style defaults / production values, if you keep any
#                on disk at all. Always loses to .env.local.
#   real env     whatever the platform injects (Vercel, docker compose
#                `environment:`) always wins over every file.
#
# Both the app and the Prisma CLI resolve variables the same way — see
# prisma.config.ts, which teaches the CLI Next.js's precedence. Without it the
# CLI reads .env only, so `pnpm db:migrate` could target a different database
# than the app you are running. Every Prisma command prints the host and
# database it is about to touch.
#
# RECOMMENDED: do not keep production secrets in a local .env at all. Set them
# in the hosting platform's environment UI. A production database URL sitting
# on a laptop is one `pnpm db:migrate` away from being a very bad afternoon,
# and `docker-compose.yml` reads `.env` for its `env_file`, which would pull
# those secrets into local containers.
#
# SECURITY: never commit a real env file — .gitignore covers `.env*` except
# this example. The values below are safe local-development defaults only.

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
# Used by `pnpm dev` / `pnpm prisma ...` when running OUTSIDE Docker, against
# Postgres on your machine (e.g. `docker compose up postgres` on its own, or
# a native Postgres install). Inside Docker Compose this is intentionally
# overridden to use the `postgres` service hostname instead of `localhost` —
# see docker-compose.yml's `app.environment.DATABASE_URL`.
DATABASE_URL=postgresql://basilissa:basilissa_password@localhost:5432/basilissa_feedback

# These three configure the Postgres container itself in docker-compose.yml,
# and are also used to build the in-container DATABASE_URL automatically —
# change the password here, not in DATABASE_URL above, so both stay in sync.
POSTGRES_DB=basilissa_feedback
POSTGRES_USER=basilissa
POSTGRES_PASSWORD=basilissa_password

# Host port the app is published on (`docker compose up`). Change if 3000
# is already taken on your machine.
APP_PORT=3000

# -----------------------------------------------------------------------------
# Sessions / admin auth
# -----------------------------------------------------------------------------
# Signs the admin session cookie (JWT). Generate a real one with:
#   openssl rand -base64 32
# Must be at least 32 characters. Changing it invalidates all active
# admin sessions.
SESSION_SECRET=dev-only-secret-change-me-to-a-random-32-byte-base64-string

# -----------------------------------------------------------------------------
# Email Server Gateway (NanaTrade Server / Nodemailer)
# -----------------------------------------------------------------------------
# REST endpoint for sending transactional emails (built on Nodemailer).
# Defaults to https://nana-trade-server.vercel.app/email
EMAIL_SERVER_URL=https://nana-trade-server.vercel.app/email

# -----------------------------------------------------------------------------
# SMS Gateway — Mobile Staff OTP Authentication
# -----------------------------------------------------------------------------
# REST endpoint for sending SMS. Leave unset in development to log OTPs to console.
SMS_GATEWAY_URL=https://api.sms-gateway.com/v1/send
# Authorization token (optional / placeholder). If left blank or unset, requests are dispatched without an Authorization header.
SMS_GATEWAY_AUTH_TOKEN=
SMS_SENDER_ID=Basilissa

# -----------------------------------------------------------------------------
# App URL
# -----------------------------------------------------------------------------
# Used to build QR code links and the "view in dashboard" link in
# notification emails. Set this to the real public URL in production.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# Seed data (pnpm prisma db seed / docker compose exec app pnpm prisma db seed)
# -----------------------------------------------------------------------------
# Only used the FIRST time the seed script creates the admin account — once
# that account exists, re-running the seed never overwrites its password,
# so changing these later has no effect on an already-seeded admin.
# CHANGE THESE before running against anything but your own machine.
SEED_ADMIN_EMAIL=admin@basilissa.gh
SEED_ADMIN_PASSWORD=ChangeMe123!
SEED_ADMIN_NAME=Basilissa Admin

# -----------------------------------------------------------------------------
# Background Worker & Cron Jobs
# -----------------------------------------------------------------------------
# Secret token for authenticating HTTP cron calls (/api/cron/attendance)
# Generate with: openssl rand -hex 32
CRON_SECRET=dev-cron-secret-change-in-production

# Standalone worker daemon intervals (worker/index.ts):
# WORKER_POLL_INTERVAL_MS: How often to poll for email jobs (default: 60000 = 1 min)
# WORKER_PERIODIC_INTERVAL_MS: How often to run periodic attendance sweeps (default: 900000 = 15 mins)
WORKER_PERIODIC_INTERVAL_MS=900000
WORKER_POLL_INTERVAL_MS=60000

# -----------------------------------------------------------------------------
# Slack Server Notifications
# -----------------------------------------------------------------------------
# Webhook URL for server errors, job failures, and delivery alerts
SLACK_WEBHOOK_URL=

